# Hosted Supabase, or the local emulator at http://127.0.0.1:54321.
# Leave both public vars empty to stay signed out. IndexedDB still works.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. The daily scan reads signed-in users' boards with this key.
# Never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Required for /api/cron/scan. Vercel sends Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=

# Optional fallback boards. Also used when Supabase is not configured.
# {"sources":[...],"searches":[...]}
SCAN_SOURCES_JSON=

# Digest is off unless both are set. The webhook receives JSON. This app does not send email.
DIGEST_ENABLED=false
DIGEST_WEBHOOK_URL=
